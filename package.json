{
  "name": "luux",
  "private": true,
  "description": "LUUX shop: Next.js storefront plus Express API",
  "scripts": {
    "dev": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run dev:all",
    "dev:all": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- concurrently -n web,api -c cyan,magenta \"npm run dev --prefix frontend\" \"npm run dev --prefix backend-server\"",
    "dev:frontend": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run dev --prefix frontend",
    "dev:backend": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run dev --prefix backend-server",
    "build:frontend": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run build --prefix frontend",
    "build:backend": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run build --prefix backend-server",
    "import:shopify": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run import:shopify --prefix backend-server",
    "test": "node -e \"require(process.env.npm_package_json+'/../scripts/with-drive.js')\" -- npm run test --prefix backend-server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
