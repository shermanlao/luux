{
  "name": "luux",
  "private": true,
  "description": "LUUX shop: Next.js storefront plus Express API",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev --prefix frontend\" \"npm run dev --prefix backend-server\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend-server",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend-server",
    "import:shopify": "npm run import:shopify --prefix backend-server",
    "test": "npm run test --prefix backend-server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
