# Copy to backend-server/.env for local development.
# Leave DATABASE_URL unset for local SQLite (backend-server/database.sqlite).

# Production / PostgreSQL on the VPS:
# DATABASE_URL=postgres://luux:password@127.0.0.1:5432/luux
# DB_DIALECT=postgres

PORT=3333
SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First-boot admin (used only when admin_users is empty)
ADMIN_EMAIL=admin@luux.local
ADMIN_PASSWORD=abc4321
ADMIN_SESSION_SECRET=change-me-long-random

# Stripe (test keys locally; live keys on the VPS)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional order email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LUUX <hello@luuxmart.com>
